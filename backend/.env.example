# Environment Configuration for Software Dependency Impact Analyzer

# Core Application Settings
PROJECT_NAME="Software Dependency Impact Analyzer"
ENVIRONMENT="development"
DEBUG="True"
PORT="8000"
HOST="127.0.0.1"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Note: For native Windows installation, set your PostgreSQL postgres user password.
# To disable database persistence and run pure in-memory, leave DATABASE_URL blank or unset.
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/dependency_analyzer_dev"
DB_ECHO="False"
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="10"
DB_POOL_TIMEOUT="30.0"

# External Security Intelligence (OSV REST API)
OSV_API_BASE_URL="https://api.osv.dev/v1/query"
OSV_TIMEOUT_SECONDS="5.0"

# Maximum Manifest Upload Size (Bytes)
MAX_UPLOAD_SIZE_BYTES="10485760"
